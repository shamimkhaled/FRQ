SECRET_KEY=your-secret-key-here
DEBUG=True
# Comma-separated hosts. Add your LAN IP if you open the app from another device.
ALLOWED_HOSTS=localhost,127.0.0.1

# Email settings (use console backend for development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noc@kloud.com

# Team emails
SALES_TEAM_EMAIL=sales@kloud.com
NOC_TEAM_EMAIL=noc@kloud.com
MANAGEMENT_EMAIL=management@kloud.com
ACCOUNTS_EMAIL=accounts@kloud.com
